<!DOCTYPE html>
<html>
  <head>
    <title>Bulk Action Platform</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <%= link_to "Bulk Action Platform", root_path, class: "brand" %>
        <nav>
          <%= link_to "Bulk Actions", ui_bulk_actions_path %>
          <%= link_to "New Bulk Action", new_ui_bulk_action_path %>
          <%= link_to "Contacts", ui_contacts_path %>
          <%= link_to "Sidekiq", "/sidekiq", target: "_blank", data: { turbo: false } %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
